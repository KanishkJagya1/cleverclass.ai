# ---------------------------------------------------------------------------
# Frontend environment
# Copy to .env.local for development. Vercel reads these from project settings.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical tags, OpenGraph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://kohinoortez.com

# FastAPI assistant backend. next.config.ts rewrites /api/ai/* here, and
# app/api/chat/route.ts proxies the SSE stream through it.
# Local:      http://localhost:8000
# Render:     https://kohinoor-assistant.onrender.com
BACKEND_URL=http://localhost:8000

# Optional shared secret. Must match API_KEY in the backend .env.
# Leave unset in development.
BACKEND_API_KEY=

# ---------------------------------------------------------------------------
# Catalogue source
# ---------------------------------------------------------------------------

# Where books come from. "api" reads the real catalogue; "seed" uses the
# deterministic generated data and needs no backend at all.
# Unset => "api" when CATALOG_API_URL is set, otherwise "seed".
# In development the api adapter falls back to seed data if the backend is down,
# with a loud warning. In production it does NOT — an error page beats serving
# invented prices to a customer.
CATALOG_SOURCE=api

# Catalogue API base URL. Defaults to BACKEND_URL when unset.
CATALOG_API_URL=http://localhost:8000

# Shared secret for POST /api/revalidate, which the backend calls after an admin
# save. Must match FRONTEND_REVALIDATE_SECRET in the backend .env. Without it a
# price edit takes `revalidate = 43200` (12 hours) to appear on the storefront.
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Not yet wired — present so the seams are visible.
# ---------------------------------------------------------------------------

# Payments (lib/payments/provider.ts currently resolves to a stub)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Auth (lib/auth/provider.ts currently resolves to a stub)
# AUTH_SECRET=
# AUTH_URL=

# Analytics
# NEXT_PUBLIC_GA_ID=
