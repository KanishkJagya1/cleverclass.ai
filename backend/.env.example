# ---------------------------------------------------------------------------
# Backend environment — copy to .env
#
# The service runs with NONE of these set: it falls back to local embeddings,
# a Chroma store on disk, and the `echo` LLM, which answers extractively from
# retrieved context. That is deliberate — the whole stack is testable before
# any API key exists.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated. In production the frontend proxies through /api/ai/*, so
# the browser never calls this service cross-origin.
ALLOWED_ORIGINS=["http://localhost:3000","https://kohinoortez.com"]

# Optional shared secret. When set, /chat, /upload and /reindex require the
# X-API-Key header. Must match BACKEND_API_KEY in the frontend.
API_KEY=

# --- LLM -------------------------------------------------------------------
# openai | gemini | echo
LLM_PROVIDER=echo

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Low temperature on purpose: this assistant states prices, syllabus details
# and shipping terms. Creativity is a defect here, not a feature.
TEMPERATURE=0.2
MAX_TOKENS=700

# --- Embeddings ------------------------------------------------------------
# sentence-transformers | openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ----------------------------------------------------------
# chroma | memory   (memory is not persisted — re-ingests on every boot)
VECTOR_STORE=chroma
CHROMA_PATH=./vector_db/chroma
COLLECTION_NAME=kohinoor_knowledge
KNOWLEDGE_DIR=./knowledge

# --- Retrieval -------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5

# Cosine similarity floor. Below this we refuse instead of letting the model
# improvise. Re-tune whenever the knowledge base changes materially:
# too high and real questions get refused, too low and answers drift.
MIN_RELEVANCE=0.28

CACHE_SIZE=256

# --- Business facts injected into prompts ----------------------------------
COMPANY_PHONE=+91 71042 99010
COMPANY_EMAIL=kohinoortezz@gmail.com
FREE_SHIPPING_THRESHOLD=200
